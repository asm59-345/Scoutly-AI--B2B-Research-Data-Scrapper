# Scoutly AI Environment Configuration

# Backend Settings
APP_ENV=production
PORT=8000
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://yourdomain.com

# Database Connection
DATABASE_URL=sqlite:///scoutly.db
# For PostgreSQL in production:
# DATABASE_URL=postgresql://user:password@localhost:5432/scoutly

# Automation & Scraper Settings
SCRAPER_HEADLESS=true
REQUESTS_TIMEOUT=12
MAX_CONCURRENT_JOBS=4

# Optional: Celery / Redis Queue Configuration (for distributed workload)
REDIS_URL=redis://localhost:6379/0

# Optional: AI Provider Key (if integrating cloud LLMs)
OPENAI_API_KEY=
GEMINI_API_KEY=

